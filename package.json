{
  "name": "profile-service",
  "version": "0.0.1",
  "description": "Profile microservice",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:staged": "eslint $(git diff --staged --name-only --diff-filter=AM | grep ^src/.*ts$)",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest.config.e2e.js",
    "test:l10n": "ts-node -r tsconfig-paths/register src/infra/localization/validate.ts",
    "config:build": "node scripts/build-config.mjs --env=local",
    "db:url": "node scripts/build-config.mjs --print-database-url",
    "prisma:generate": "prisma generate",
    "migrate:dev": "DATABASE_URL=\"$(node scripts/build-config.mjs --print-database-url)\" prisma migrate dev",
    "migrate:deploy": "DATABASE_URL=\"$(node scripts/build-config.mjs --print-database-url)\" prisma migrate deploy",
    "infra": "docker compose up -d --wait && yarn migrate:deploy",
    "infra:down": "docker compose down",
    "prepare": "husky install",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@apollo/server-plugin-response-cache": "5.0.0",
    "@apollo/utils.keyvaluecache": "4.0.0",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dataloader": "2.2.3",
    "express": "5.2.1",
    "graphql": "16.14.2",
    "iso-639-1": "3.1.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "source-map-support": "0.5.21",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.1",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.2.5",
    "ts-morph": "25.0.1",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "node_modules",
      ".*\\.e2e\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata/Reflect.js",
      "tsconfig-paths/register",
      "dotenv/config"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
