# Server-side secrets for profile-service. Lives next to the compose file
# on the VPS and is never written by CI. Copy to .env and fill in.
#
# POSTGRES_PASSWORD must match DatabaseConfig.password in the
# CONFIG_SECRETS_JSON repository secret. Nothing syncs the two.

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install token
TUNNEL_TOKEN=

POSTGRES_USER=profile
POSTGRES_PASSWORD=
POSTGRES_DB=profile
